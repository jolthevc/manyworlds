# Copy to .env and fill in. Never commit .env.

# Control plane database. Remote GPU workers must be able to reach it
# (use a hosted Postgres such as Neon or Supabase once workers run off this machine).
DATABASE_URL=postgresql://mw:mw@localhost:5433/manyworlds

# Object storage: Cloudflare R2 in production, MinIO locally, or file:// for tests.
STORAGE_URL=s3://manyworlds
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=auto

MW_POLICY=policy/default.yaml

# Worker identity (set per container on SaladCloud / Vast.ai / RunPod).
MW_POOL=local
MW_WORKER_KINDS=fake.image,fake.video,fake.tts

# Hugging Face token for gated weights, and model overrides.
HF_TOKEN=
MW_IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo
MW_VIDEO_MODEL=Wan-AI/Wan2.2-I2V-A14B-Diffusers
MW_VIDEO_DISTILL_LORA=

# SaladCloud launcher (python -m manyworlds.deploy.salad). Org and project are the
# names in your SaladCloud portal URL; the API key is under Account Settings > API Key.
SALAD_API_KEY=
SALAD_ORG=
SALAD_PROJECT=

# Vast.ai (console.vast.ai > Account > API Keys) and RunPod (console.runpod.io >
# Settings > API Keys). The autoscaler skips a provider whose key is empty.
VAST_API_KEY=
RUNPOD_API_KEY=

# Where worker images are pushed, e.g. docker.io/<your-docker-hub-username>.
# Token only needed if the repositories are private.
MW_REGISTRY=
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Later days
ANTHROPIC_API_KEY=
APIFY_TOKEN=
